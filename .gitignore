.venv/
__pycache__/
*.pyc
.pytest_cache/
dist/
.zcode/
# operator-dropped retail fixtures + non-redistributable homebrew:
# never committed (DESIGN.md section 5)
fixtures/_local/*
!fixtures/_local/README.md
# gc-fst retail fixtures: the extracted reference bytes (full file payloads)
# are re-extracted by seedtools/stage_gc_fst.py from the gitignored ISO and
# never committed; only the metadata manifest commits.
fixtures/gc_fst/*/reference/
# gc-fst nested fixture: the ~1.4 GiB disc image is materialized on demand by
# seedtools/make_gc_fst_nested_fixture.py (the committed recipe); only the
# metadata manifest commits. Built from the gitignored retail ISO's sys region.
fixtures/gc_fst/nested/game.iso
# PS1 retail anchor: independent 7-Zip reference extraction stays local;
# only the metadata manifest and provenance are committed.
fixtures/ps1_bincue/kings-field/reference/
fixtures/ps1_bincue/burstrick/reference/
# PSP retail anchor: independent 7-Zip reference extraction stays local;
# only the metadata manifest and provenance are committed.
fixtures/cso/ape-escape/reference/
# PS2 retail ISO anchor: independent 7-Zip reference extraction stays local;
# only the metadata manifest and provenance are committed.
fixtures/iso9660/gallop-racer-2001/reference/
# 3DS retail CCI anchor: independently extracted opaque partition payloads
# stay local; only the metadata manifest and provenance are committed.
fixtures/3ds_cci/cubic-ninja/reference/
# 3DS decrypted NCCH anchor: independently extracted opaque regions stay
# local; only the metadata manifest and provenance are committed.
fixtures/3ds_ncch/cubic-ninja/reference/
# 3DS encrypted-NCCH retail anchor: ctrtool/3dstool independently extracted
# decrypted region references stay local; only the metadata manifest and
# provenance are committed. No key bytes or decrypted retail payloads enter git.
fixtures/3ds_ncch_enc/biohazard/reference/
# 3DS 7.x-seed encrypted-NCCH retail anchors: ctrtool-decrypted region
# references stay local; only the metadata manifests and provenance commit.
fixtures/3ds_ncch_enc_seed/boxboxboy/reference/
fixtures/3ds_ncch_enc_seed/mini-sports/reference/
# 3DS CIA retail anchor: the on-media encrypted content blob (opaque NCCH)
# stays local; only the metadata manifest and provenance are committed.
fixtures/3ds_cia/biohazard/reference/
# Wii retail disc anchor: complete opaque encrypted partition references stay
# local; only the metadata manifest and provenance are committed.
fixtures/wii_disc/munchables/reference/
# Wii keyed-partition retail anchor: wit's independently extracted decrypted
# reference regions stay local; only the metadata manifest and provenance are
# committed. No key bytes or decrypted retail payloads enter git.
fixtures/wii_partition/munchables/reference/
# Wii FST retail anchor: wit's independently extracted decrypted DATA-partition
# file payloads stay local; only the metadata manifest commits.
fixtures/wii_fst/munchables/reference/
